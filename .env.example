# Cổng lắng nghe (Render tự động cấp PORT khi deploy, local mặc định 3000 hoặc 6001)
PORT=3000

# Khóa bí mật đồng bộ giữa Laravel Study và Realtime Hub
APP_KEY=vttu_key_2026
INTERNAL_SECRET=13467902

# URL của website Laravel Study để Hub gọi webhook chốt thời lượng khi sinh viên thoát
STUDY_API_URL=http://localhost:8000

# Thời gian chờ (giây) trước khi chốt ngắt kết nối (giúp sinh viên F5 / chuyển trang không bị ngắt)
GRACE_SECONDS=8

# Danh sách allowed origins cho CORS (phân tách bằng dấu phẩy, để * nếu chấp nhận mọi domain)
CORS_ORIGIN=*
